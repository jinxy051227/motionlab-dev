# Recommended: Vertex AI with Application Default Credentials (no API key)
MOTIONLAB_AI_PROVIDER=vertex
GOOGLE_CLOUD_PROJECT=YOUR_PROJECT_ID
GOOGLE_CLOUD_LOCATION=global
GEMINI_MODEL=gemini-2.5-flash

# Alternative Gemini Developer API: set MOTIONLAB_AI_PROVIDER=developer and a
# GEMINI_API_KEY locally, never commit this file or share the key.
# MOTIONLAB_AI_PROVIDER=developer
# GEMINI_API_KEY=YOUR_API_KEY
